        <mxCell id="node_email" value="&lt;b&gt;Adviser email&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Client services shared inbox&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E6;strokeColor=#FF9F36;fontSize=12;fontColor=#0B1F33;verticalAlign=middle;" vertex="1" parent="zone_arrive">
          <mxGeometry x="20" y="50" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="node_portal" value="&lt;b&gt;Customer portal&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Tax certificate on the request form&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E6;strokeColor=#FF9F36;fontSize=12;fontColor=#0B1F33;verticalAlign=middle;" vertex="1" parent="zone_arrive">
          <mxGeometry x="20" y="300" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="node_inbox" value="&lt;b&gt;Shared inbox&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Checked twice a day&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF5FB;strokeColor=#11567F;fontSize=12;fontColor=#0B1F33;" vertex="1" parent="zone_cs">
          <mxGeometry x="30" y="50" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="node_lookup" value="&lt;b&gt;Client lookup&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Admin system. Reply if no client reference&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF5FB;strokeColor=#11567F;fontSize=12;fontColor=#0B1F33;" vertex="1" parent="zone_cs">
          <mxGeometry x="30" y="160" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="node_log" value="&lt;b&gt;Log and forward&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Query logged. Email to Tax Operations mailbox&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF5FB;strokeColor=#11567F;fontSize=12;fontColor=#0B1F33;" vertex="1" parent="zone_cs">
          <mxGeometry x="30" y="280" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="node_queue" value="&lt;b&gt;Tax Operations queue&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Portal: client reference already attached&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F7FC;strokeColor=#29B5E8;fontSize=12;fontColor=#0B1F33;" vertex="1" parent="zone_tax">
          <mxGeometry x="20" y="300" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="node_holdings" value="&lt;b&gt;Holdings check&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Holdings and whether a certificate exists&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F7FC;strokeColor=#29B5E8;fontSize=12;fontColor=#0B1F33;" vertex="1" parent="zone_tax">
          <mxGeometry x="210" y="170" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="node_print" value="&lt;b&gt;Next print run&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Northgate Print and Post. Twice a week&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F7FC;strokeColor=#29B5E8;fontSize=12;fontColor=#0B1F33;" vertex="1" parent="zone_tax">
