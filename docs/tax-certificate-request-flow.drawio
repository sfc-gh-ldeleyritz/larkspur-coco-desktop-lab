        <mxCell id="edge_print_northgate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#29B5E8;strokeWidth=2;endArrow=classic;endFill=1;" edge="1" parent="1" source="node_print" target="node_northgate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_northgate_close_email" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#29B5E8;strokeWidth=2;endArrow=classic;endFill=1;" edge="1" parent="1" source="node_northgate" target="node_close_email">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_northgate_close_portal" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#29B5E8;strokeWidth=1;dashed=1;dashPattern=5 5;endArrow=classic;endFill=1;" edge="1" parent="1" source="node_holdings" target="node_close_portal">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="790" y="480" />
              <mxPoint x="1365" y="480" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_delay_inbox" style="edgeStyle=orthogonalEdgeStyle;rounded=1;dashed=1;dashPattern=3 3;strokeColor=#844519;strokeWidth=1;endArrow=classic;endFill=1;" edge="1" parent="1" source="node_delay_friday" target="node_inbox">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_delay_log" style="edgeStyle=orthogonalEdgeStyle;rounded=1;dashed=1;dashPattern=3 3;strokeColor=#844519;strokeWidth=1;endArrow=classic;endFill=1;" edge="1" parent="1" source="node_delay_forward" target="node_log">
          <mxGeometry relative="1" as="geometry" />
