        </mxCell>
        <mxCell id="node_northgate" value="&lt;b&gt;Northgate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Print and post the certificate&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F7FC;strokeColor=#29B5E8;fontSize=12;fontColor=#0B1F33;" vertex="1" parent="zone_tax">
          <mxGeometry x="590" y="170" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="node_close_email" value="&lt;b&gt;Close, email route&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Client services emails the adviser&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF6EE;strokeColor=#226242;fontSize=12;fontColor=#0B1F33;" vertex="1" parent="zone_resolved">
          <mxGeometry x="30" y="90" width="190" height="80" as="geometry" />
        </mxCell>
        <mxCell id="node_close_portal" value="&lt;b&gt;Close, portal route&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Closes on upload or dispatch. Portal notification&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF6EE;strokeColor=#226242;fontSize=12;fontColor=#0B1F33;" vertex="1" parent="zone_resolved">
          <mxGeometry x="30" y="280" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="node_delay_friday" value="&lt;b&gt;No inbox owner on Fridays&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Shared inbox&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E6;strokeColor=#844519;fontSize=12;fontColor=#0B1F33;" vertex="1" parent="zone_delays">
          <mxGeometry x="20" y="50" width="350" height="70" as="geometry" />
        </mxCell>
        <mxCell id="node_delay_forward" value="&lt;b&gt;Email forward is not tracked&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Client services to Tax Operations&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E6;strokeColor=#844519;fontSize=12;fontColor=#0B1F33;" vertex="1" parent="zone_delays">
          <mxGeometry x="390" y="50" width="350" height="70" as="geometry" />
        </mxCell>
        <mxCell id="node_delay_print" value="&lt;b&gt;Proposed dispatch: 5 to 8 working days&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Northgate renewal, January to March&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E6;strokeColor=#844519;fontSize=12;fontColor=#0B1F33;" vertex="1" parent="zone_delays">
          <mxGeometry x="760" y="50" width="360" height="70" as="geometry" />
        </mxCell>
        <mxCell id="node_delay_status" value="&lt;b&gt;No status until the query closes&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Email requests only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E6;strokeColor=#844519;fontSize=12;fontColor=#0B1F33;" vertex="1" parent="zone_delays">
          <mxGeometry x="1140" y="50" width="350" height="70" as="geometry" />
        </mxCell>
        <mxCell id="step_1" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#29B5E8;strokeColor=#29B5E8;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="zone_arrive">
          <mxGeometry x="164" y="42" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="step_2" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#29B5E8;strokeColor=#29B5E8;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="zone_cs">
          <mxGeometry x="174" y="42" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="step_3" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#29B5E8;strokeColor=#29B5E8;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="zone_cs">
          <mxGeometry x="174" y="152" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="step_4" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#29B5E8;strokeColor=#29B5E8;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="zone_cs">
          <mxGeometry x="174" y="272" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="step_5" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#29B5E8;strokeColor=#29B5E8;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="zone_tax">
          <mxGeometry x="354" y="162" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="step_6" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#29B5E8;strokeColor=#29B5E8;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="zone_tax">
          <mxGeometry x="544" y="162" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="step_7" value="7" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#29B5E8;strokeColor=#29B5E8;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="zone_tax">
          <mxGeometry x="724" y="162" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="step_8" value="8" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#29B5E8;strokeColor=#29B5E8;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="zone_resolved">
          <mxGeometry x="204" y="82" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="desc_panel" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF5FB;strokeColor=#29B5E8;arcSize=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="20" y="860" width="1520" height="380" as="geometry" />
        </mxCell>
        <mxCell id="desc_title" value="Process overview" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#0B1F33;align=left;verticalAlign=top;" vertex="1" parent="desc_panel">
          <mxGeometry x="20" y="10" width="400" height="28" as="geometry" />
        </mxCell>
        <mxCell id="desc_overview" value="Source: Process note, tax certificate requests from advisers. Owner: Client Services. Service level: 72 hours from receipt to resolution. Phone is a third arrival route and is not drawn." style="text;html=1;fontSize=11;fontColor=#0B1F33;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="desc_panel">
          <mxGeometry x="20" y="42" width="1480" height="36" as="geometry" />
        </mxCell>
        <mxCell id="desc_step_1" value="&lt;b&gt;1. Email.&lt;/b&gt; The adviser writes to the client services shared inbox." style="text;html=1;fontSize=11;fontColor=#0B1F33;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="desc_panel">
          <mxGeometry x="20" y="84" width="1480" height="22" as="geometry" />
        </mxCell>
        <mxCell id="desc_step_2" value="&lt;b&gt;2. Shared inbox.&lt;/b&gt; Checked twice a day. No owner on Fridays." style="text;html=1;fontSize=11;fontColor=#0B1F33;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="desc_panel">
          <mxGeometry x="20" y="110" width="1480" height="22" as="geometry" />
        </mxCell>
        <mxCell id="desc_step_3" value="&lt;b&gt;3. Client lookup.&lt;/b&gt; Administrator looks up the client. Emails often have no client reference, so they may reply to the adviser." style="text;html=1;fontSize=11;fontColor=#0B1F33;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="desc_panel">
          <mxGeometry x="20" y="136" width="1480" height="22" as="geometry" />
        </mxCell>
        <mxCell id="desc_step_4" value="&lt;b&gt;4. Log and forward.&lt;/b&gt; Query is logged and the email is forwarded to the Tax Operations mailbox. That forward is not tracked." style="text;html=1;fontSize=11;fontColor=#0B1F33;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="desc_panel">
          <mxGeometry x="20" y="162" width="1480" height="22" as="geometry" />
        </mxCell>
        <mxCell id="desc_step_5" value="&lt;b&gt;5. Holdings check.&lt;/b&gt; Tax Operations checks holdings and whether a certificate has already been issued. Portal requests arrive here with the client reference attached." style="text;html=1;fontSize=11;fontColor=#0B1F33;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="desc_panel">
          <mxGeometry x="20" y="188" width="1480" height="22" as="geometry" />
        </mxCell>
        <mxCell id="desc_step_6" value="&lt;b&gt;6. Print run.&lt;/b&gt; If a certificate is needed, it joins the next Northgate print run. Runs go out twice a week. Proposed January to March renewal: dispatch 5 to 8 working days." style="text;html=1;fontSize=11;fontColor=#0B1F33;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="desc_panel">
          <mxGeometry x="20" y="214" width="1480" height="28" as="geometry" />
        </mxCell>
        <mxCell id="desc_step_7" value="&lt;b&gt;7. Northgate.&lt;/b&gt; Prints and posts the certificate. Portal route can instead upload an existing certificate copy." style="text;html=1;fontSize=11;fontColor=#0B1F33;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="desc_panel">
          <mxGeometry x="20" y="246" width="1480" height="22" as="geometry" />
        </mxCell>
        <mxCell id="desc_step_8" value="&lt;b&gt;8. Resolved query.&lt;/b&gt; Email route: client services closes the query and emails the adviser. Advisers cannot see email-request status until then. Portal route: the query closes when the certificate is uploaded or dispatched, and the adviser gets a portal notification." style="text;html=1;fontSize=11;fontColor=#0B1F33;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="desc_panel">
          <mxGeometry x="20" y="272" width="1480" height="40" as="geometry" />
        </mxCell>
        <mxCell id="desc_source" value="Document: docs/tax-certificate-process.pdf. Last reviewed March 2025. Open questions in the note (redirect email to the portal; upload copies for email requests) are not drawn as steps." style="text;html=1;fontSize=11;fontColor=#0B1F33;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="desc_panel">
          <mxGeometry x="20" y="322" width="1480" height="36" as="geometry" />
        </mxCell>
