          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_delay_close" style="edgeStyle=orthogonalEdgeStyle;rounded=1;dashed=1;dashPattern=3 3;strokeColor=#844519;strokeWidth=1;endArrow=classic;endFill=1;" edge="1" parent="1" source="node_delay_status" target="node_close_email">
